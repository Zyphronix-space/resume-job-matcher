# Copy to backend/.env.local (git-ignored) for local overrides. Placeholders only.

# Defaults to a local SQLite file when unset. Production uses a TiDB/MySQL URL
# set in the Vercel project's environment variables, never in this file.
DATABASE_URL=sqlite:///./resume_match.db

# Required on any deployment (startup fails on Vercel without it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value

# Comma-separated frontend origins allowed by CORS, in addition to localhost.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Local demos only: return password-reset tokens in the API response because
# no email service exists. Never set this on a public deployment.
# PASSWORD_RESET_DEMO_MODE=1
